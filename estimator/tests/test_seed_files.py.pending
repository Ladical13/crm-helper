"""Every file `_seed_data_dir()` copies must actually ship in the repo.

`app.py::_seed_data_dir` populates a fresh DATA_DIR (a new Railway volume) from
the app directory, but it copies `if os.path.exists(src)` — so a seed file that
is missing or gitignored is skipped in **silence**. The volume then comes up
without it and the customer-facing trust blocks render empty.

That is exactly what happened to `company_content.json`: it sat in the seed list
while `.gitignore` excluded it, which also broke four estimator tests on every
fresh clone (CI included) because `conftest.py` copies it in only `if exists`.

Two assertions, because the file existing locally is not the same as it shipping
— an untracked file passes the first check on the machine that created it and
fails everywhere else, which is the failure mode that hid this for a week.
"""
import os
import subprocess

import pytest

import app as estimator_app


HERE = os.path.dirname(os.path.abspath(__file__))
EST  = os.path.dirname(HERE)

# The literal list _seed_data_dir() copies. Kept in sync by
# test_seed_list_matches_app, below, so this can never quietly drift.
SEED_FILES = ('price_book.json', 'tier_defaults.json', 'permit_defaults.json',
              'jurisdictions.json', 'commercial_fastening.json',
              'company_content.json')


@pytest.mark.parametrize('fname', SEED_FILES)
def test_seed_file_exists(fname):
    assert os.path.exists(os.path.join(EST, fname)), (
        f'{fname} is in _seed_data_dir() but missing from estimator/. '
        f'A fresh DATA_DIR will silently come up without it.')


@pytest.mark.parametrize('fname', SEED_FILES)
def test_seed_file_is_tracked_by_git(fname):
    """Present on disk is not enough — it has to be IN the repo.

    Skips rather than fails outside a git checkout (a Railway build has no
    .git), since there is nothing meaningful to assert there.
    """
    try:
        out = subprocess.run(
            ['git', 'ls-files', '--error-unmatch', f'estimator/{fname}'],
            cwd=os.path.dirname(EST), capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        pytest.skip('git not available')
    if not os.path.isdir(os.path.join(os.path.dirname(EST), '.git')):
        pytest.skip('not a git checkout')
    assert out.returncode == 0, (
        f'estimator/{fname} is a seed file but is not tracked by git — '
        f'check .gitignore. It will be missing on every fresh clone, in CI, '
        f'and on any rebuilt Railway volume.')


def test_seed_list_matches_app():
    """Guards SEED_FILES above against drift in app.py's own list."""
    src = open(os.path.join(EST, 'app.py'), encoding='utf-8').read()
    start = src.index('def _seed_data_dir')
    # The module-level call that follows the definition — anchored to a newline
    # so it cannot match the `def _seed_data_dir():` line itself.
    body  = src[start:src.index('\n_seed_data_dir()', start)]
    for fname in SEED_FILES:
        assert fname in body, f'{fname} no longer seeded by app.py — update SEED_FILES'
    # And the reverse: nothing new in app.py that this file does not cover.
    import re
    named = set(re.findall(r"'([A-Za-z_]+\.json)'", body))
    assert named <= set(SEED_FILES), (
        f'app.py seeds files this test does not check: {named - set(SEED_FILES)}')
