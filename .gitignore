# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Estimator — user data (stays local or on Railway volume, not in git)
estimator/estimates/
estimator/uploads/
estimator/config.json
estimator/users.json
estimator/company_content.json
estimator/app_settings.json

# Portal — the shared user store (password hashes; never in git)
portal.db
portal.db-journal
.localdata/

# CRM helper / reporting scripts (contain API tokens, not needed on Railway)
weekly_report.py
sheets_report.py
CO_Weekly_Report.xlsx
*.xlsx
*.csv

# Claude Code local config — may hold tokens and machine-specific settings.
# CLAUDE.md is deliberately NOT ignored: it is the project's documentation and
# holds only env-var names and <placeholders>, never a real secret. Keeping it
# tracked means the accumulated invariants survive a dead laptop like the code.
.claude/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prospector working files - pulled segments and browser harvests, sometimes large
prospector/inbox/*
!prospector/inbox/.gitkeep
